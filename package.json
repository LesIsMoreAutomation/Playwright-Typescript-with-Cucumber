{
  "name": "playwright-cucumber",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js -p runner --parallel=3 && node reporter-config.ts",
    "test:parallel": "cucumber-js -p runner --parallel=2 && node reporter-config.ts",
    "test:firefox": "BROWSER=firefox cucumber-js -p runner && node reporter-config.ts",
    "generate-report": "cucumber-html-reporter --format json:report/cucumber_report.json --format html:report/cucumber_report.html --name 'Playwright Cucumber Report' --template templates/html.hbs"
  },
  "keywords": [
    "cucumber",
    "playwright",
    "playwright automation",
    "test automation",
    "TypeScript"
  ],
  "author": "Lesibana Moselakgomo",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.51.1",
    "eslint-plugin-playwright": "^0.12.0",
    "playwright": "^1.51.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "csv-parser": "^3.0.0",
    "cucumber-html-reporter": "^7.2.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^4.2.1",
    "fs-extra": "^11.3.0"
  }
}
